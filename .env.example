# Copy this file to .env and set your own key. Never commit .env.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_OCR_MODEL=gemini-3.8-flash

# Local paths and retrieval settings
CHROMA_DB_PATH=data/chroma_db
CHROMA_COLLECTION=gtbit_knowledge
RETRIEVAL_TOP_K=5
GEMINI_MAX_RETRIES=3

# Page limit: 300 by default; set to 0 to remove the cap.
GTBIT_MAX_PAGES=300

# OCR sends scanned PDF page images to Gemini and may incur API usage.
ENABLE_SCANNED_PDF_OCR=false

# Allowed local frontend origins (comma-separated).
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
HOST=127.0.0.1
PORT=5000
